<UserControl x:Class="PrintBridge.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7FB" Foreground="#142943" FontFamily="Segoe UI" FontSize="14">
  <UserControl.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#CEDBEC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Background" Value="#E4EEFB"/>
      <Setter Property="Foreground" Value="#204D86"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".52"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#204D86"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".82"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="ContentPanel" Margin="26">
      <DockPanel Margin="0,0,0,20" LastChildFill="True">
        <Image Source="Resources/DashboardIcon.png" Width="38" Height="38" DockPanel.Dock="Left" Margin="0,0,10,0"/>
        <TextBlock Text="PrintBridge" FontSize="29" FontWeight="Bold" VerticalAlignment="Center"/>
      </DockPanel>
      <Border Style="{StaticResource Card}" Background="#E8F1FC" Padding="16,13">
        <StackPanel>
          <WrapPanel VerticalAlignment="Center">
            <TextBlock FontSize="21" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,12,0">
              <Hyperlink x:Name="PrinterLink" Foreground="#204D86">
                <Run x:Name="PrinterName"/>
              </Hyperlink>
            </TextBlock>
            <Border x:Name="StatusPill" CornerRadius="12" Padding="9,4" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusIcon" FontWeight="Bold" Margin="0,0,5,0"/>
                <TextBlock x:Name="ConnectionStatus" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
          </WrapPanel>
          <TextBlock x:Name="FailureReason" Margin="0,7,0,0" Foreground="#753847"/>
          <WrapPanel Margin="0,12,0,0">
            <Button x:Name="Configure" Background="#204D86" Foreground="White"/>
            <Button x:Name="Check" Background="#204D86" Foreground="White"/>
            <Button x:Name="TestPage"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <UniformGrid Columns="2">
        <Border Style="{StaticResource Card}" Margin="0,0,6,12">
          <StackPanel>
            <TextBlock x:Name="QueueLabel" FontWeight="SemiBold"/>
            <TextBlock Margin="0,6,0,0">
              <Hyperlink x:Name="QueueLink" Foreground="#204D86">
                <Run x:Name="QueueName"/>
              </Hyperlink>
            </TextBlock>
            <TextBlock x:Name="QueueJobs" Foreground="#48617D"/>
            <TextBlock x:Name="QueueDetails" Foreground="#48617D"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6,0,0,12">
          <StackPanel>
            <TextBlock x:Name="NetworkLabel" FontWeight="SemiBold"/>
            <TextBlock x:Name="NetworkSummary" Margin="0,6,0,0" Foreground="#48617D"/>
          </StackPanel>
        </Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Expander x:Name="Bridge" Margin="0,0,0,12">
            <TextBox x:Name="BridgeSummary" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="144" VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="22,8,0,0"/>
          </Expander>
          <Expander x:Name="Routing">
            <TextBox x:Name="RouteSummary" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="144" VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="22,8,0,0"/>
          </Expander>
        </StackPanel>
      </Border>
      <WrapPanel>
        <Button x:Name="Preferences"/>
        <Button x:Name="More"/>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

