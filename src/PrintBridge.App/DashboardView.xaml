<UserControl x:Class="PrintBridge.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7FB" Foreground="#142943" FontFamily="Segoe UI" FontSize="14">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="WindowStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>
      <Style x:Key="DiagnosticSection" TargetType="Expander">
        <Setter Property="Foreground" Value="#586C83"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      </Style>
      <Style x:Key="DiagnosticText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="#48617D"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="22,4,8,4"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="PART_ContentHost" Background="{TemplateBinding Background}"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MoreMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="#142943"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="MenuItem">
              <Border x:Name="Surface" Background="Transparent" CornerRadius="7" Padding="10,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <ContentPresenter ContentSource="Icon" VerticalAlignment="Center"/>
                  <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="Surface" Property="Background" Value="#E4EEFB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Surface" Property="Opacity" Value=".5"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="4"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <ProgressBar x:Name="CheckProgress" Visibility="Hidden" IsTabStop="False"/>
    <Grid Grid.Row="1" Margin="26,18,26,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,16" LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="Preferences" Margin="8,0,0,0"/>
          <Button x:Name="More" Margin="8,0,0,0">
            <Button.ContextMenu>
              <ContextMenu x:Name="MoreMenu" Placement="Bottom" MinWidth="218"
                           Background="White" BorderBrush="#CEDBEC" FontFamily="Segoe UI" FontSize="14">
                <ContextMenu.Template>
                  <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="5">
                      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                      </ScrollViewer>
                    </Border>
                  </ControlTemplate>
                </ContextMenu.Template>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
        <Image Source="Resources/DashboardIcon.png" Width="38" Height="38" DockPanel.Dock="Left" Margin="0,0,10,0"/>
        <TextBlock Text="PrintBridge" FontSize="29" FontWeight="Bold" VerticalAlignment="Center"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <Border Grid.Row="1" Style="{StaticResource Card}" Background="#E8F1FC" Padding="16,13">
        <StackPanel>
          <Grid Height="32">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MaxWidth="300"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="StatusPill" Grid.Column="1" HorizontalAlignment="Left" CornerRadius="12" Padding="9,4" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusIcon" FontWeight="Bold" Margin="0,0,5,0"/>
                <TextBlock x:Name="ConnectionStatus" FontWeight="SemiBold" MaxWidth="260"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              </StackPanel>
            </Border>
            <TextBlock FontSize="21" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,12,0"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, ElementName=PrinterName}">
              <Hyperlink x:Name="PrinterLink" Foreground="#204D86">
                <Run x:Name="PrinterName"/>
              </Hyperlink>
            </TextBlock>
          </Grid>
          <TextBlock x:Name="FailureReason" Height="20" Margin="0,4,0,0" Foreground="#753847"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <WrapPanel Margin="0,4,0,0">
            <Button x:Name="Configure" Background="#204D86" Foreground="White"/>
            <Button x:Name="Check" Background="#204D86" Foreground="White"/>
            <Button x:Name="TestPage" Background="White" BorderBrush="#AFC3DB"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <UniformGrid Grid.Row="2" Columns="2">
        <Border Style="{StaticResource Card}" Margin="0,0,6,12">
          <StackPanel>
            <TextBlock x:Name="QueueLabel" FontWeight="SemiBold"/>
            <TextBlock Margin="0,6,0,0">
              <Hyperlink x:Name="QueueLink" Foreground="#204D86">
                <Run x:Name="QueueName"/>
              </Hyperlink>
            </TextBlock>
            <TextBlock x:Name="QueueJobs" Foreground="#48617D"/>
            <TextBlock x:Name="QueueDetails" Foreground="#48617D"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6,0,0,12">
          <StackPanel>
            <TextBlock x:Name="NetworkLabel" FontWeight="SemiBold"/>
            <TextBlock x:Name="NetworkSummary" Margin="0,6,0,0" Foreground="#48617D"/>
          </StackPanel>
        </Border>
      </UniformGrid>
      <Border Grid.Row="3" Style="{StaticResource Card}" Background="#F8FAFD" Padding="14" Margin="0">
        <ScrollViewer x:Name="DiagnosticScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Expander x:Name="Bridge" Style="{StaticResource DiagnosticSection}" Margin="0,0,0,8">
              <TextBox x:Name="BridgeSummary" Style="{StaticResource DiagnosticText}"/>
            </Expander>
            <Expander x:Name="Routing" Style="{StaticResource DiagnosticSection}">
              <TextBox x:Name="RouteSummary" Style="{StaticResource DiagnosticText}"/>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>

