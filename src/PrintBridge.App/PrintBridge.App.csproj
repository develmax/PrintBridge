<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>PrintBridge</AssemblyName>
    <RootNamespace>PrintBridge</RootNamespace>
    <ApplicationIcon>Resources/PrintBridge.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PrintBridgeSignedRelease)' == 'true'">
    <DefineConstants>$(DefineConstants);SIGNED_RELEASE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/PrintBridge.ico" LogicalName="PrintBridge.AppIcon" />
    <ProjectReference Include="../PrintBridge.Infrastructure/PrintBridge.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
  </ItemGroup>
</Project>
