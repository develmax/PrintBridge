<Window x:Class="PrintBridge.PreferencesWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="650" Height="620" MinWidth="510" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F4F7FB" Foreground="#142943" FontFamily="Segoe UI" FontSize="14"
        Icon="Resources/DashboardIcon.png">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="WindowStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>
      <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="#365776"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TabItem">
              <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                      CornerRadius="8" Padding="13,8" Margin="0,0,6,8">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="TabSurface" Property="Background" Value="#EDF3FA"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="TabSurface" Property="Background" Value="#E4EEFB"/>
                  <Setter Property="Foreground" Value="#204D86"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="TabSurface" Property="BorderBrush" Value="#204D86"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TabContent" TargetType="ScrollViewer">
        <Setter Property="Padding" Value="19"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="26,18,26,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <Image Source="Resources/DashboardIcon.png" Width="32" Height="32"/>
      <TextBlock x:Name="Heading" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>
    </StackPanel>
    <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="White" BorderBrush="#CEDBEC" Padding="0">
      <TabItem x:Name="GeneralTab">
        <ScrollViewer Style="{StaticResource TabContent}"><StackPanel x:Name="General"/></ScrollViewer>
      </TabItem>
      <TabItem x:Name="NetworkTab">
        <ScrollViewer Style="{StaticResource TabContent}"><StackPanel x:Name="Network"/></ScrollViewer>
      </TabItem>
      <TabItem x:Name="MaintenanceTab">
        <ScrollViewer Style="{StaticResource TabContent}"><StackPanel x:Name="Maintenance"/></ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="SaveButton" IsDefault="True" MinWidth="96" Margin="4,0" Background="#204D86" Foreground="White"/>
      <Button x:Name="CancelButton" IsCancel="True" MinWidth="96" Margin="4,0" Background="White" BorderBrush="#AFC3DB"/>
    </StackPanel>
  </Grid>
</Window>
